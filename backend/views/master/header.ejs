<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %></title>

  <link rel="icon" type="image/png" href="/images/QV-logo.png">
  <link rel="stylesheet" href="/css/style.css">

  <% if (typeof extraCSS !== 'undefined') { extraCSS.forEach(function(css) { %>
  <link rel="stylesheet" href="<%= css %>">
  <% }); } %>

  <% if (typeof headScripts !== 'undefined') { headScripts.forEach(function(src) { %>
  <script src="<%= src %>"></script>
  <% }); } %>
  <script>
    window.QV_PUBLIC_URL = '<%= typeof publicUrl !== 'undefined' ? publicUrl : '' %>' || location.origin;
    window.QV_SECURE_URL = '<%= typeof secureUrl !== 'undefined' ? secureUrl : '' %>';
  </script>

  <% if (typeof guard !== 'undefined') { %>
  <script>
    // Role-based page guard (runs before the page renders)
    (function () {
      var guard = '<%= guard %>';
      var token = localStorage.getItem('qv_token');
      var user = null;
      try { user = JSON.parse(localStorage.getItem('qv_user')); } catch (e) {}
      var loggedIn = !!(token && user);

      if (guard === 'guest') {
        // Already logged in -> go to the right home for this role
        if (loggedIn) location.replace(user.role === 'admin' ? '/admin' : '/tourist');
      } else if (guard === 'admin') {
        if (!loggedIn) location.replace('/login');
        else if (user.role !== 'admin') location.replace('/tourist');
      }
    })();
  </script>
  <% } %>
</head>

<body>

<nav class="topnav">
  <a href="/" class="logo">
    <div class="logo-icon">QV</div>
    <span><%= typeof navBrand !== 'undefined' ? navBrand : 'QuickVisit' %></span>
  </a>

  <div class="nav-links">
    <% if (typeof navType !== 'undefined' && navType === 'admin') { %>
      <a href="/">Home</a>
      <span id="admin-name">Welcome, Admin</span>
      <a href="#" onclick="logout(); return false;">Logout</a>
    <% } else if (typeof navType !== 'undefined' && navType === 'login') { %>
      <a href="/">Home</a>
      <a href="/tourist">Book Tickets</a>
    <% } else if (typeof navType !== 'undefined' && navType === 'tourist') { %>
      <a href="/">Home</a>
      <a href="/login" id="loginLink">Login</a>
    <% } else { %>
      <a href="/tourist">Book Tickets</a>
      <a href="/login" id="loginLink">Login</a>
    <% } %>
  </div>
</nav>
