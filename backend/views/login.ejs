<%- include("master/header") %>

<div class="auth-container">
  <h2 id="form-title">Login to QuickVisit</h2>

  <div id="alert" style="display: none;"></div>

  <!-- LOGIN FORM -->
  <form id="loginForm">
    <div class="form-group">
      <label for="email">Email Address</label>
      <input type="email" id="email" required placeholder="you@example.com">
    </div>
    <div class="form-group">
      <label for="password">Password</label>
      <input type="password" id="password" required placeholder="Enter password">
    </div>
    <button type="submit" class="btn-primary">Login</button>
  </form>

  <!-- REGISTER FORM (hidden by default) -->
  <form id="registerForm" style="display: none;">
    <div class="form-group">
      <label for="reg-name">Full Name</label>
      <input type="text" id="reg-name" required>
    </div>
    <div class="form-group">
      <label for="reg-email">Email Address</label>
      <input type="email" id="reg-email" required>
    </div>
    <div class="form-group">
      <label for="reg-phone">Phone Number</label>
      <input type="tel" id="reg-phone" placeholder="+91 9999999999">
    </div>
    <div class="form-group">
      <label for="reg-password">Password</label>
      <input type="password" id="reg-password" required minlength="6">
    </div>
    <button type="submit" class="btn-primary">Create Account</button>
  </form>

  <p class="auth-link" id="toggle-link">
    Don't have an account? <a href="#" onclick="toggleForm(); return false;">Register here</a>
  </p>
</div>

<script src="/js/api.js"></script>
<script src="/js/auth.js"></script>
<script>
  function toggleForm() {
    const loginForm = document.getElementById('loginForm');
    const registerForm = document.getElementById('registerForm');
    const title = document.getElementById('form-title');
    const link = document.getElementById('toggle-link');

    if (loginForm.style.display === 'none') {
      loginForm.style.display = 'block';
      registerForm.style.display = 'none';
      title.textContent = 'Login to QuickVisit';
      link.innerHTML = 'Don\'t have an account? <a href="#" onclick="toggleForm(); return false;">Register here</a>';
    } else {
      loginForm.style.display = 'none';
      registerForm.style.display = 'block';
      title.textContent = 'Create your QuickVisit account';
      link.innerHTML = 'Already have an account? <a href="#" onclick="toggleForm(); return false;">Login here</a>';
    }
  }
</script>

<%- include("master/footer") %>
