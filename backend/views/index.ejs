<%- include("master/header") %>

<section class="hero">
  <h1>Skip the Queue, Start Your Journey</h1>

  <p>
    QuickVisit transforms tourist destination ticketing
    with QR code scanning, instant booking, and secure
    digital tickets. No app installation required.
  </p>

  <div class="hero-actions">

    <a href="/tourist" class="btn-primary">
      Book Tickets Now
    </a>

    <a href="#features" class="btn-secondary">
      Learn More
    </a>

  </div>
</section>

<section id="features" class="features">

  <h2>Why Choose QuickVisit?</h2>

  <div class="feature-grid">

    <div class="feature-card">
      <div class="feature-icon">QR</div>

      <h3>QR Code Scanning</h3>

      <p>
        Scan QR codes at tourist locations to instantly
        access booking pages. No queues, no waiting.
      </p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">$</div>

      <h3>Secure Payments</h3>

      <p>
        Pay safely using UPI, cards, net banking,
        or digital wallets with our payment gateway.
      </p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">T</div>

      <h3>Digital Tickets</h3>

      <p>
        Receive digital tickets with unique QR codes
        via email, SMS, or in-app storage.
      </p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">M</div>

      <h3>Mobile-First Design</h3>

      <p>
        Responsive web application that works on any
        device with a browser. No app to install.
      </p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">P</div>

      <h3>Dynamic Pricing</h3>

      <p>
        Fair pricing for adults, children, and seniors
        with early-bird discounts and group offers.
      </p>
    </div>

    <div class="feature-card">
      <div class="feature-icon">A</div>

      <h3>Admin Dashboard</h3>

      <p>
        Destination operators get powerful tools for
        managing bookings, payments, and analytics.
      </p>
    </div>

  </div>

</section>

<section class="features" style="background: white; padding: 60px 20px; margin: 0;">

  <h2>How It Works</h2>

  <div class="feature-grid">

    <div class="feature-card">

      <div class="feature-icon">1</div>

      <h3>Scan QR at Entry</h3>

      <p>
        Point your phone camera at the QR code displayed
        at the tourist destination entrance.
      </p>

    </div>

    <div class="feature-card">

      <div class="feature-icon">2</div>

      <h3>Select & Pay</h3>

      <p>
        Choose number of visitors, time slot,
        and complete payment in less than 30 seconds.
      </p>

    </div>

    <div class="feature-card">

      <div class="feature-icon">3</div>

      <h3>Enter Instantly</h3>

      <p>
        Show your digital ticket QR code at the gate.
        Instant validation, no paper required.
      </p>

    </div>

  </div>

</section>

<%- include("master/footer") %>